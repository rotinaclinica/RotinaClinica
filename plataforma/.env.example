# === BANCO DE DADOS (Supabase) ===
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# === AUTH.JS ===
# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# === STRIPE ===
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# === MERCADO PAGO ===
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MERCADOPAGO_WEBHOOK_SECRET=""   # Obrigatório — sem isso todos os webhooks MP são rejeitados

# === MUX (vídeos do curso) ===
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""
MUX_SIGNING_KEY_ID=""
MUX_SIGNING_KEY_PRIVATE=""

# === CLOUDFLARE R2 (arquivos para download) ===
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="plataforma-downloads"
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"

# === RESEND (emails transacionais) ===
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@seudominio.com.br"

# === SETUP ADMIN ===
SETUP_SECRET=""   # Necessário para criar conta admin inicial via /api/setup

# === URL DO SITE ===
NEXT_PUBLIC_APP_URL="https://seudominio.com.br"
NEXTAUTH_URL="https://seudominio.com.br"   # URL canônica usada nos links de e-mail (reset de senha)

# === CRON (Vercel) ===
CRON_SECRET=""   # Bearer usado pelos crons (broadcast, lembretes de renovação, emissão de notas)

# === LGPD — CRIPTOGRAFIA DE CPF ===
# Chave AES-256 (32 bytes em base64) para criptografar CPFs no banco.
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ⚠️ Se perder essa chave, todos os CPFs armazenados ficam irrecuperáveis.
# Guarde uma cópia em local seguro (gerenciador de senhas).
CPF_ENCRYPTION_KEY=""
# Pepper (opcional) para o hash de busca de CPF. Trocar exige remigrar os hashes.
# Gerar: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
CPF_HASH_PEPPER=""

# === NOTA FISCAL (NFS-e) ===
# Enquanto NFE_ENABLED != "true", todo o sistema de nota fica em no-op (não emite nada).
# Ligue só depois de contratar o provedor e ter TODOS os dados fiscais abaixo.
NFE_ENABLED="false"
NFE_PROVIDER="asaas"                        # asaas | focusnfe

# -- Opção A: Asaas (paga por nota, sem mensalidade) --
ASAAS_BASE_URL="https://api.asaas.com/v3"   # sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=""                            # chave de API da conta Asaas (PJ)
ASAAS_MUNICIPAL_SERVICE_ID=""               # id do serviço municipal cadastrado no Asaas
ASAAS_MUNICIPAL_SERVICE_CODE=""             # ou o código do serviço da prefeitura
ASAAS_MUNICIPAL_SERVICE_NAME=""             # ou o nome do serviço

# -- Opção B: Focus NFe (mensalidade + por nota) --
FOCUSNFE_BASE_URL="https://api.focusnfe.com.br"   # produção. Homologação: https://homologacao.focusnfe.com.br
FOCUSNFE_TOKEN=""                           # token de produção da Focus NFe

# -- Emitente (sua empresa / prestador) --
NFE_CNPJ=""                                 # só dígitos
NFE_INSCRICAO_MUNICIPAL=""
NFE_CODIGO_MUNICIPIO_IBGE=""                # código IBGE da sua cidade (7 dígitos)

# -- Serviço prestado (assinatura/curso) --
NFE_ITEM_LISTA_SERVICO=""                   # item da LC 116 (ex: 8.02 para ensino)
NFE_CODIGO_TRIBUTARIO_MUNICIPIO=""          # código de serviço da prefeitura
NFE_ALIQUOTA_ISS="0"                        # alíquota ISS em % (ex: 2)
NFE_ISS_RETIDO="false"
NFE_SIMPLES_NACIONAL="true"
NFE_DISCRIMINACAO="Assinatura de plataforma de conteúdo clínico (Rotina Clínica)"
